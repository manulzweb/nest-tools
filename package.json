{
  "name": "@manulz/nest-tools",
  "version": "1.2.0",
  "description": "CLI utilities and runtime helpers for NestJS",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "nest-tools": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manulzweb/nest-tools.git"
  },
  "keywords": [
    "nestjs",
    "cli",
    "tools",
    "clean-architecture",
    "generator"
  ],
  "author": "Manulz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/manulzweb/nest-tools/issues"
  },
  "homepage": "https://github.com/manulzweb/nest-tools#readme",
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@types/node": "^22.10.1",
    "rxjs": "^7.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
